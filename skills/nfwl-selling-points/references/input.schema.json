{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product": {
      "type": "object",
      "properties": {
        "sku_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "unit": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "confirmed",
                  "needs_review",
                  "conflict",
                  "missing",
                  "not_applicable"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allowed_claims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "key",
              "value",
              "status",
              "source_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "user",
                  "manual",
                  "measurement",
                  "manufacturer",
                  "test_fixture"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "ref"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "message",
              "patterns"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "competitor_brands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sample_kind": {
          "enum": [
            "real",
            "synthetic"
          ]
        }
      },
      "required": [
        "sku_id",
        "name",
        "category",
        "facts",
        "sources"
      ],
      "additionalProperties": false
    },
    "instruction": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "desired_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "competitor_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "voc": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "product",
    "language"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
